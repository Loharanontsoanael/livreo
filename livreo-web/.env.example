# Copier en .env.local et remplir. Tout secret manquant met l'intégration
# concernée en simulation (voir GET /api/sante) : on peut développer sans compte Meta.

# --- App Meta (developers.facebook.com > votre app) ---
# Paramètres > Général : identifiant et clé secrète (la clé signe les webhooks)
META_APP_ID=
META_APP_SECRET=
# Chaîne libre, à recopier dans la configuration du webhook
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0
# Facebook Login for Business (app de type Entreprise) : l'identifiant de la
# configuration créée dans Facebook Login for Business > Configurations.
# Vide : Facebook Login classique (permissions demandées par « scope »).
META_LOGIN_CONFIG_ID=
# Adresse publique du serveur (tunnel ou hébergeur), sans « / » final. Sert à
# l'URL de retour de Facebook : https://<adresse>/api/auth/facebook/retour
LIVREO_URL_PUBLIQUE=

# --- Page de secours (facultatif) ---
# En temps normal, chaque vendeuse connecte SA Page avec « Continuer avec
# Facebook » : les jetons sont rangés chiffrés en base, pas ici. Cette Page
# sert seulement au développement et de repli pour la démo.
# Le plus simple : coller ici un jeton UTILISATEUR de l'explorateur Graph,
# puis lancer « node ../outils/configurer-meta.mjs jeton » : il remplit les
# deux lignes suivantes avec un jeton de Page qui n'expire pas, et s'efface.
META_USER_TOKEN=
META_PAGE_ID=
# Jeton d'accès de Page (pages_messaging, pages_read_engagement,
# pages_read_user_content, pages_manage_metadata)
META_PAGE_ACCESS_TOKEN=
LIVREO_NOM_PAGE=Chez Nirina

# --- Meta Model API (dev.meta.ai) ---
MODEL_API_KEY=
MUSE_MODELE=muse-spark-1.3

# --- Règles du live ---
LIVREO_DELAI_MIN=30
LIVREO_SEUIL_CONFIANCE=0.7
# Numéro Mobile Money affiché dans le récap
LIVREO_NUMERO_PAIEMENT=

# --- Serveur ---
# Clé de chiffrement des jetons de Page en base (par défaut : META_APP_SECRET).
LIVREO_CLE_CHIFFREMENT=
# Clé d'accès provisoire de l'app vendeuse (obligatoire en production)
LIVREO_CLE_VENDEUSE=
LIVREO_BASE=./donnees/livreo.db
# Autorise POST /api/rejeu en production (toujours autorisé en développement)
LIVREO_REJEU=
